# ========== SEGURANÇA ==========

# Chave secreta para sessões (gere uma única vez com python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# ========== AUTENTICAÇÃO ADMIN ==========
# Senha para a área administrativa (hash)
ADMIN_PASSWORD_HASH=

# ========== CONFIGURAÇÕES DO BANCO DE DADOS ==========

# (Opcional) Se preferir usar uma URL completa, pode usar DATABASE_URI no lugar das variáveis acima
DATABASE_URI=

# Dialeto do banco
DB_DIALECT=

# Usuário do MySQL
DB_USER=

# Senha do MySQL
DB_PASSWORD=

# Host do MySQL
DB_HOST=

# Porta do MySQL
DB_PORT=

# Nome do banco de dados
DB_NAME=

